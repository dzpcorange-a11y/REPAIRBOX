function normalizePin_(pin) {
  return String(pin == null ? '' : pin).trim()
    .replace(/[٠-٩]/g, function(d){ return String('٠١٢٣٤٥٦٧٨٩'.indexOf(d)); })
    .replace(/[۰-۹]/g, function(d){ return String('۰۱۲۳۴۵۶۷۸۹'.indexOf(d)); })
    .replace(/\s+/g, '');
}

function _finishAuthentication_(user) {
  const sessionId = Utilities.getUuid();
  const logResult = logUserConnection(user.name, user.role, sessionId);
  if (!logResult || !logResult.success) {
    return {success:false,error:'تعذر تسجيل عملية الدخول في سجل العاملين: '+((logResult&&logResult.error)||'خطأ غير معروف')};
  }
  return {success:true,user:user,sessionId:logResult.sessionId || sessionId};
}

function authenticateUser(pin) {
  try {
    const cleanPin=normalizePin_(pin);
    if(!cleanPin) return {success:false,error:'يرجى إدخال كود PIN'};
    if(cleanPin==='0000') return {success:false,error:'كود PIN غير صحيح!'};
    const defaults={
      '808085':{name:'المدير العام',role:'ADMIN',techFilter:'ALL'},
      '17744':{name:'سلامي (فني)',role:'TECH',techFilter:'سلامي'},
      '860000':{name:'الهمكة (فني)',role:'TECH',techFilter:'الهمكة'},
      '16003':{name:'مداني (فني)',role:'TECH',techFilter:'مداني'},
      '101090':{name:'قزم (فني)',role:'TECH',techFilter:'قزم'},
      '202020':{name:'بوعلام (فني)',role:'TECH',techFilter:'بوعلام'}
    };
    const ss=getSpreadsheet();
    const ws=getSheetAuto(ss,['الموظفين','Workers']);
    if(ws && ws.getLastRow()>1){
      const vals=ws.getDataRange().getValues();
      for(let i=1;i<vals.length;i++){
        if(String(vals[i][2]||'').replace(/^'/,'').trim()===cleanPin){
          const roleRaw=String(vals[i][1]||'').trim();
          const role=roleRaw==='فني'||roleRaw==='TECH'?'TECH':(roleRaw==='ADMIN'?'ADMIN':'STORE');
          const workerName = String(vals[i][0] || '').trim();
          const workerTechFilter = role === 'TECH'
            ? workerName.replace(/\(\s*فني\s*\)/gi, '').replace(/فني/gi, '').replace(/[\s\u00A0]+/g, ' ').trim()
            : 'ALL';
          return _finishAuthentication_({name:workerName,role,techFilter:workerTechFilter});
        }
      }
    }
    if(defaults[cleanPin]) return _finishAuthentication_(defaults[cleanPin]);
    return {success:false,error:'كود PIN غير صحيح!'};
  }catch(error){return {success:false,error:error.toString()};}
}

function changeOwnTechPin(techName, role, oldPin, newPin) {
  try {
    if(String(role||'')!=='TECH') return {success:false,error:'هذه الخاصية متاحة للفني فقط.'};
    const oldP=normalizePin_(oldPin), newP=normalizePin_(newPin);
    if(newP.length<4) return {success:false,error:'الكود الجديد يجب أن يكون 4 أرقام على الأقل.'};
    if(oldP===newP) return {success:false,error:'الكود الجديد مطابق للكود الحالي.'};
    const ss=getSpreadsheet(); let ws=ensureRepairBoxWorkersSeeded_();
    const vals=ws.getDataRange().getValues(); let found=false;
    for(let i=1;i<vals.length;i++){
      const name=String(vals[i][0]||'').trim(), pin=String(vals[i][2]||'').replace(/^'/,'').trim();
      if(pin===newP) return {success:false,error:'الكود الجديد مستخدم لحساب آخر.'};
      if(name===String(techName||'').trim() && (String(vals[i][1]||'').trim()==='فني'||String(vals[i][1]||'').trim()==='TECH')){
        if(pin!==oldP) return {success:false,error:'الكود الحالي غير صحيح.'};
        ws.getRange(i+1,3).setValue("'"+newP); found=true; break;
      }
    }
    if(!found){
      const defaults={'سلامي':'17744','الهمكة':'860000','مداني':'16003','قزم':'101090','بوعلام':'202020'};
      if(defaults[String(techName||'').trim()]!==oldP) return {success:false,error:'الكود الحالي غير صحيح.'};
      ws.appendRow([String(techName||''),'فني',"'"+newP]);
    }
    return {success:true};
  }catch(error){return {success:false,error:error.toString()};}
}

