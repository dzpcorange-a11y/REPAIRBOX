function logUserConnection(userName, userRole, sessionId) {
  try {
    const ss = getSpreadsheet();
    const name = String(userName || '').trim();
    const role = String(userRole || '').trim().toUpperCase();
    const sid = String(sessionId || Utilities.getUuid()).trim();
    if (!name || !role) return {success:false,error:'بيانات المستخدم ناقصة.'};
    const now = new Date();
    const nowStr = Utilities.formatDate(now, ss.getSpreadsheetTimeZone(), 'yyyy-MM-dd HH:mm:ss');

    // قفل موحّد يمنع إنشاء جلستين نشطتين لنفس العامل عند الضغط مرتين
    // أو عند حدوث طلبَي دخول متقاربين جداً.
    const lock = LockService.getScriptLock();
    lock.waitLock(10000);
    try {
      // سجل تاريخي مستقل: كل دخول حقيقي يبقى في سجل الدخول.
      const logSheet = _getLoginLogSheet_(ss);
      logSheet.appendRow([nowStr, name, role]);

      // جلسة حية: لا نسمح بأكثر من جلسة ONLINE لنفس المستخدم/الرتبة.
      const sessionSheet = _getUserSessionSheet_(ss);
      const values = sessionSheet.getDataRange().getValues();
      let row = -1;
      for (let i = 1; i < values.length; i++) {
        const existingSid = String(values[i][0] || '').trim();
        const existingName = String(values[i][1] || '').trim();
        const existingRole = String(values[i][2] || '').trim().toUpperCase();
        const existingStatus = String(values[i][6] || '').trim().toUpperCase();

        if (existingSid === sid) row = i + 1;

        // إذا كان نفس العامل مسجلاً بجلسة أخرى، أغلق الجلسة القديمة.
        // هذا يمنع ظهور "قزم" مرتين في المتصلين حالياً.
        if (existingSid && existingSid !== sid && existingName === name && existingRole === role && existingStatus !== 'OFFLINE') {
          sessionSheet.getRange(i + 1, 6, 1, 2).setValues([[nowStr, 'OFFLINE']]);
        }
      }

      const rowData = [sid, name, role, nowStr, nowStr, nowStr, 'ONLINE', now.getTime()];
      if (row > 0) sessionSheet.getRange(row, 1, 1, rowData.length).setValues([rowData]);
      else sessionSheet.appendRow(rowData);
    } finally {
      lock.releaseLock();
    }

    return {success:true, sessionId:sid, timestamp:nowStr};
  } catch (error) {
    return {success:false,error:error.toString()};
  }
}

function heartbeatUserSession(userName, userRole, sessionId) {
  try {
    const ss = getSpreadsheet();
    const sid = String(sessionId || '').trim();
    if (!sid) return {success:false,error:'معرف الجلسة مفقود.'};
