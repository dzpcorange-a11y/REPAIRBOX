function getTopStatsSummary(techFilter, userRole) {
  try {
    const ss = getSpreadsheet();
    const sheet = getSheetAuto(ss, ["الأجهزة", "Devices"]);
    const empty = {success:true,inWorkshop:0,delayed:0,ready:0,newDevicesCount:0,retourCount:0,
      waitingCount:0,repairingCount:0,readyWorkshopCount:0,sentToStoreCount:0,readyStoreCount:0,
      techReadyCount:0,notRepairableCount:0};
    if (!sheet || sheet.getLastRow() <= 1) return empty;

    const values = sheet.getDataRange().getValues();
    const filter = normalizeTechName_(techFilter || 'ALL');
    const isTech = String(userRole || '').trim().toUpperCase() === 'TECH';
    const scoped = isTech && filter && filter !== 'all';
    const now = new Date();
    let waitingCount=0, inWorkshop=0, repairingCount=0, readyWorkshopCount=0,
        techReadyCount=0, sentToStoreCount=0, readyStoreCount=0,
        notRepairableCount=0, delayed=0, retourCount=0, newDevicesCount=0, ready=0;

    for (let i=1; i<values.length; i++) {
      const row=values[i];
      if(!row[0]) continue;
      const techName=String(row[8]||'').trim();
      const status=String(row[10]||'').trim();
      const location=String(row[9]||'').trim();
      const problemText=String(row[7]||'');

      if(status==='مؤرشف ومسلم' || status.includes('تم التسليم') || location.includes('الأرشيف')) continue;

      // الفني يرى أرقامه من أجهزته فقط. المدير/الاستقبال يرون الإجمالي.
      const belongs = !scoped || techNamesMatch_(techName, filter);
      if(!belongs) continue;

      if(problemText.includes('RETOUR')) retourCount++;

      if(status==='في الانتظار') {
        waitingCount++;
        newDevicesCount++;
      }
      if(status==='في انتظار قبول الفني' || status==='قيد التصليح في الورشة') {
        inWorkshop++;
        repairingCount++;
      }
      if(status.includes('جاهز في الورشة') || status.includes('جاهز بالورشة')) {
        inWorkshop++;
        readyWorkshopCount++;
        techReadyCount++;
        ready++;
      }
      if(status.includes('غير قابل للتصليح')) {
        // يظهر للفني كجهاز منتهٍ لكنه لا يختلط مع الأجهزة القابلة للإصلاح.
        techReadyCount++;
        ready++;
        notRepairableCount++;
      }
      if(status==='مرسل للمحل') {
        sentToStoreCount++;
        // getDevicesByStage('tech_ready') يعرضه ضمن أجهزة الفني الجاهزة/المتابعة.
        techReadyCount++;
      }
      if(status==='جاهز للتسليم في المحل') {
        readyStoreCount++;
      }

      if((status==='في انتظار قبول الفني'||status==='قيد التصليح في الورشة')) {
        const entryDateStr=String(row[14]||'').trim();
        if(entryDateStr){
          const entryDate=new Date(entryDateStr.replace(/-/g,'/'));
          const diffMs=now-entryDate;
          if(!isNaN(diffMs) && Math.floor(diffMs/86400000)>=30) delayed++;
        }
      }
    }

    // في الواجهة الخاصة بالفني، "جاهز" هو ما يظهر في تبويب tech_ready.
    // أما المدير/الاستقبال فـ ready هو الجاهز للتسليم بالمحل.
    if(!isTech) ready=readyStoreCount;

    return {success:true,inWorkshop,delayed,ready,newDevicesCount,retourCount,waitingCount,repairingCount,
      readyWorkshopCount,sentToStoreCount,readyStoreCount,techReadyCount,notRepairableCount};
  } catch(error){
    return {success:false,error:error.toString()};
  }
}

// عدادات الشريط الجانبي: مصدر واحد لعدادات الفني والمدير والاستقبال.
// الفني يحصل حصراً على أجهزة الفني نفسه، باستخدام نفس منطق المطابقة الموجود في القوائم.
function getSidebarCountsForUser(userName, userRole, techFilter) {
  try {
    // V24.29: قراءة العدادات مباشرة وبأمان عند أول فتح، مع تهيئة قاعدة البيانات
    // إذا كانت الورقة غير موجودة بعد (لا نعتمد على أن المستخدم ضغط زرًا أولاً).
    const role=String(userRole||'').trim().toUpperCase();
    const filter=role==='TECH' ? String(techFilter||userName||'').trim() : 'ALL';
    const r=getTopStatsSummary(filter, role);
    if(!r || !r.success) return r || {success:false,error:'تعذر حساب العدادات'};
    return {
      success:true,
      waiting:Number(r.waitingCount||0),
      workshop:Number(r.inWorkshop||0),
      tech_ready:Number(r.techReadyCount||0),
      ready:Number(r.readyStoreCount||0),
      receive:Number(r.sentToStoreCount||0),
      retour:Number(r.retourCount||0),
      technician:filter
    };
  } catch(e){ return {success:false,error:String(e&&e.message?e.message:e)}; }
}

// V24.29: لقطة أولية موحدة للواجهة. القراءة فقط، وتعيد العدادات بسرعة في طلب واحد.
function getInitialDashboardSnapshot(userName, userRole, techFilter) {
  try {
    const role=String(userRole||'').trim().toUpperCase();
    const filter=role==='TECH' ? String(techFilter||userName||'').trim() : 'ALL';
    const counts=getSidebarCountsForUser(userName,role,filter);
    if(!counts || counts.success===false) return counts || {success:false,error:'تعذر تحميل العدادات.'};
    return {success:true,counts:counts};
  } catch(e){ return {success:false,error:String(e&&e.message?e.message:e)}; }
}

function globalSearchDeviceByCode(query) {
  try {
    const ss = getSpreadsheet();
    const sheet = getSheetAuto(ss, ["الأجهزة", "Devices"]);
    if (!sheet || sheet.getLastRow() <= 1) return { success: true, data: [] };

    // توحيد أرقام الهاتف: يدعم الأرقام العربية، المسافات، +213، والرمز ' المخفي.
    const normalizeDigits = function(value) {
      return String(value || '')
        .replace(/[٠-٩]/g, function(d){ return '٠١٢٣٤٥٦٧٨٩'.indexOf(d); })
        .replace(/[^0-9]/g, '');
    };

    const rawQ = String(query || '').trim().toLowerCase();
    const qDigits = normalizeDigits(rawQ);
    if (!rawQ) return { success: true, data: [] };

    const values = sheet.getDataRange().getValues();
    const results = [];

    for (let i = values.length - 1; i >= 1; i--) {
      const row = values[i];
      const receipt = String(row[0] || '').toLowerCase().trim();
      const phone = String(row[3] || '').toLowerCase().trim();
      const name = String(row[2] || '').toLowerCase().trim();

      const receiptDigits = normalizeDigits(receipt);
      const phoneDigits = normalizeDigits(phone);

      // رقم الوصل + رقم الهاتف + الاسم.
      // الهاتف يقبل البحث حتى مع اختلاف المسافات أو +213 أو الأرقام العربية.
      const receiptMatch = receipt.includes(rawQ) ||
                           (qDigits && receiptDigits.includes(qDigits));
      const phoneMatch = qDigits && (
        phoneDigits.includes(qDigits) || qDigits.includes(phoneDigits) ||
        (phoneDigits.startsWith('213') && phoneDigits.slice(3).includes(qDigits.replace(/^0/, ''))) ||
        (qDigits.startsWith('213') && qDigits.slice(3).includes(phoneDigits.replace(/^0/, '')))
      );
      const nameMatch = name.includes(rawQ);

      if (receiptMatch || phoneMatch || nameMatch) {
        results.push({
          rowId: i + 1,
          receipt: String(row[0] || ''),
          date: String(row[1] || ''),
          customerName: String(row[2] || ''),
          customerPhone: String(row[3] || '').replace(/^'/, ''),
          deviceType: [row[4], row[5], row[6]].filter(Boolean).join(' '),
          problem: String(row[7] || ''),
          techName: String(row[8] || ''),
          location: String(row[9] || ''),
          status: String(row[10] || ''),
          techCost: parseNumber(row[11]),
          salePrice: parseNumber(row[12]),
          notes: String(row[13] || ''),
          entryWorkshopDate: String(row[14] || ''),
          exitWorkshopDate: String(row[15] || '')
        });
      }
    }
    return { success: true, data: results };
  } catch (error) {
    return { success: false, error: error.toString() };
  }
}


// V21: حساب رصيد الفني بالاسم مع توحيد صيغ الاسم (مثل "الهمكة" و"الهمكة (فني)").
// V23.8: توحيد أسماء الفنيين لمنع التكرار مثل "المداني" و"مداني".
// لا نغيّر البيانات الأصلية في Google Sheets؛ التوحيد يتم أثناء الحساب والعرض فقط.
function normalizeTechName_(name) {
  // V24.0: تطبيع قوي لأسماء الفنيين لمنع التكرار حتى مع اختلافات
  // ال التعريف، المسافات، التشكيل، التطويل، ومحارف Unicode المخفية.
  let n = String(name || '')
    .normalize('NFKC')
    .replace(/[\u200B-\u200F\u202A-\u202E\u2060\uFEFF]/g, '')
    .replace(/[\u064B-\u065F\u0670\u06D6-\u06ED]/g, '')
    .replace(/ـ/g, '')
    .replace(/\(\s*فني\s*\)/gi, '')
    .replace(/فني/gi, '')
    .replace(/[\s\u00A0]+/g, '')
    .trim()
    .toLowerCase();

  // توحيد بعض أشكال الحروف العربية الشائعة.
  n = n
    .replace(/[إأآٱ]/g, 'ا')
    .replace(/ى/g, 'ي')
    .replace(/ؤ/g, 'و')
    .replace(/ئ/g, 'ي');

  // إزالة ال التعريف من البداية: المداني = مداني.
  n = n.replace(/^ال(?=[\u0600-\u06FF])/u, '');
  return n;
}

function canonicalTechDisplayName_(name) {
  let n = String(name || '')
    .normalize('NFKC')
    .replace(/[\u200B-\u200F\u202A-\u202E\u2060\uFEFF]/g, '')
    .replace(/[\u064B-\u065F\u0670\u06D6-\u06ED]/g, '')
    .replace(/ـ/g, '')
    .replace(/\(\s*فني\s*\)/gi, '')
    .replace(/فني/gi, '')
    .replace(/[\s\u00A0]+/g, ' ')
    .trim();
  n = n.replace(/^ال(?=[\u0600-\u06FF])/u, '');
  return n || String(name || '').trim();
}

function techNamesMatch_(a,b) {
  const x=normalizeTechName_(a), y=normalizeTechName_(b);
  if(!x || !y) return false;
  return x===y;
}

// V22: رصيد الفني من المصدر مباشرة، مع مطابقة الاسم المرنة.
function getTechDashboardBalance(techName, techFilter) {
  try {
    setupDatabase();
    const ss=getSpreadsheet();
    const devSheet=getSheetAuto(ss,["الأجهزة","Devices"]);
    const paySheet=getSheetAuto(ss,["مدفوعات الفنيين","TechPayments"]);
    const name=String(techName||techFilter||'').trim();
    if(!name) return {success:false,error:'اسم الفني غير محدد.'};
    let earned=0, paid=0, matchedDevices=0, matchedPayments=0;
    if(devSheet && devSheet.getLastRow()>1){
      const vals=devSheet.getDataRange().getValues();
      for(let i=1;i<vals.length;i++){
        const r=vals[i];
        if(!techNamesMatch_(r[8],name)) continue;
        const status=String(r[10]||'').trim();
        if(status==='ملغى الوصل' || status.includes('ملغى')) continue;
        const amount=parseNumber(r[11]);
        if(amount>0){ earned+=amount; matchedDevices++; }
      }
    }
    if(paySheet && paySheet.getLastRow()>1){
      const vals=paySheet.getDataRange().getValues();
      for(let i=1;i<vals.length;i++){
        const r=vals[i];
        if(!techNamesMatch_(r[1],name)) continue;
        const amount=parseNumber(r[2]);
        if(amount>0){ paid+=amount; matchedPayments++; }
      }
    }
    return {success:true,techName:name,totalEarned:earned,totalPaid:paid,netBalance:earned-paid,matchedDevices,matchedPayments};
  } catch(e){ return {success:false,error:String(e&&e.message?e.message:e)}; }
}

// V24.52: تاريخ استحقاق الفني = لحظة إنهاء الصيانة، وليس لحظة التسليم للزبون أو الإرسال للمحل.
function _rbTechEarnedDate_(row, ss) {
  const notes=String(row[13]||'');
  const matches=notes.match(/\[(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2})\]/g)||[];
  for(let i=matches.length-1;i>=0;i--){
    const stamp=matches[i].replace(/^\[|\]$/g,'');
    const pos=notes.lastIndexOf(matches[i]);
    const after=notes.slice(pos+matches[i].length);
    if(after.indexOf('تم إنهاء التصليح في الورشة')>=0 || after.indexOf('تم تسجيل إكمال الصيانة')>=0 || after.indexOf('نوع الإغلاق:')>=0){
      const d=new Date(stamp.replace(/-/g,'/'));
      if(!isNaN(d.getTime())) return d;
    }
  }
  const d=row[14]||row[1];
  const out=d instanceof Date?d:new Date(String(d||'').replace(/-/g,'/'));
  return isNaN(out.getTime())?null:out;
}

function getTechCurrentBalance(techName, techFilter) {
  try {
    setupDatabase();
    const ss = getSpreadsheet();
    const devSheet = getSheetAuto(ss, ["الأجهزة", "Devices"]);
    const paySheet = getSheetAuto(ss, ["مدفوعات الفنيين", "TechPayments"]);
    const candidates = [techName, techFilter].map(normalizeTechName_).filter(Boolean);
    if (!candidates.length) return {success:false,error:"اسم الفني غير محدد."};
    const matches = name => {
      const n=normalizeTechName_(name);
      return candidates.some(c => n===c || n.includes(c) || c.includes(n));
    };
    let earned=0, paid=0, lastEvent=null, lastTime=0;
    if (devSheet && devSheet.getLastRow()>1) {
      const vals=devSheet.getDataRange().getValues();
      for(let i=1;i<vals.length;i++){
        const r=vals[i];
        if(!matches(r[8])) continue;
        const status=String(r[10]||'').trim();
        if(status==='ملغى الوصل' || status.includes('ملغى')) continue;
        const amount=parseNumber(r[11]);
        if(amount<=0) continue;
        earned+=amount;
        const dt=_rbTechEarnedDate_(r,ss);
        const t=isNaN(dt.getTime())?0:dt.getTime();
        if(t>=lastTime){lastTime=t;lastEvent='استحقاق إصلاح — الوصل '+String(r[0]||'')+' — '+amount.toLocaleString('ar-DZ')+' دج';}
      }
    }
    if (paySheet && paySheet.getLastRow()>1) {
      const vals=paySheet.getDataRange().getValues();
      for(let i=1;i<vals.length;i++){
        const r=vals[i];
        if(!matches(r[1])) continue;
        const amount=parseNumber(r[2]);
        if(amount<=0) continue;
        paid+=amount;
        const d=r[0];
        const dt=(d instanceof Date)?d:new Date(String(d||'').replace(/-/g,'/'));
        const t=isNaN(dt.getTime())?0:dt.getTime();
        if(t>=lastTime){lastTime=t;lastEvent='تسديد — '+amount.toLocaleString('ar-DZ')+' دج';}
      }
    }
    return {success:true,techName:String(techName||techFilter||''),totalEarned:earned,totalPaid:paid,netBalance:earned-paid,lastEvent:lastEvent};
  } catch(e){ return {success:false,error:String(e&&e.message?e.message:e)}; }
}

// سجل زمني لتغير رصيد الفني: كل استحقاق + وكل تسديد - مع الرصيد بعد كل حركة.
function getTechBalanceHistory(techName) {
  try {
    setupDatabase();
    const ss=getSpreadsheet();
    const devSheet=getSheetAuto(ss,["الأجهزة","Devices"]);
    const paySheet=getSheetAuto(ss,["مدفوعات الفنيين","TechPayments"]);
    const events=[];
    const tz=ss.getSpreadsheetTimeZone() || Session.getScriptTimeZone() || 'Africa/Algiers';
    function parseDate(v){
      if(v instanceof Date && !isNaN(v.getTime())) return v;
      const str=String(v||'').trim(); if(!str) return null;
      const d=new Date(str.replace(/-/g,'/')); return isNaN(d.getTime())?null:d;
    }
    function fmt(v){ const d=parseDate(v); return d ? Utilities.formatDate(d,tz,'yyyy-MM-dd HH:mm') : String(v||''); }
    let totalEarned=0,totalPaid=0;
    if(devSheet && devSheet.getLastRow()>1){
      const vals=devSheet.getDataRange().getValues();
      for(let i=1;i<vals.length;i++){
        const r=vals[i];
        if(!techNamesMatch_(String(r[8]||''), String(techName||''))) continue;
        const status=String(r[10]||'').trim();
        if(status==='ملغى الوصل' || status.includes('ملغى')) continue;
        const amount=parseNumber(r[11]); if(amount===0) continue;
        const dt=_rbTechEarnedDate_(r,ss);
        totalEarned+=amount;
        events.push({dateObj:dt||new Date(0),date:fmt(dt),type:'earned',amount:amount,description:'استحقاق إصلاح — تم إنهاء الصيانة — الوصل '+String(r[0]||'')});
      }
    }
    if(paySheet && paySheet.getLastRow()>1){
      const vals=paySheet.getDataRange().getValues();
      for(let i=1;i<vals.length;i++){
        const r=vals[i];
        if(!techNamesMatch_(String(r[1]||''), String(techName||''))) continue;
        const amount=parseNumber(r[2]); if(amount===0) continue;
        const dt=r[0];
        totalPaid+=amount;
        events.push({dateObj:parseDate(dt)||new Date(0),date:fmt(dt),type:'paid',amount:amount,description:'تسديد للفني'+(String(r[3]||'').trim()?' — '+String(r[3]).trim():'')});
      }
    }
    events.sort((a,b)=>a.dateObj.getTime()-b.dateObj.getTime());
    let balance=0;
    events.forEach(e=>{ balance += e.type==='paid' ? -e.amount : e.amount; e.balanceAfter=balance; delete e.dateObj; });
    events.reverse();
    return {success:true,techName:String(techName||''),totalEarned:totalEarned,totalPaid:totalPaid,netBalance:totalEarned-totalPaid,events:events};
  } catch(e){ return {success:false,error:String(e&&e.message?e.message:e)}; }
}

