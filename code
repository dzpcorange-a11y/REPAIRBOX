function getTechPersonalReports(techName, selectedMonthYear) {
  try {
    setupDatabase();
    const ss = getSpreadsheet();
    const devSheet = getSheetAuto(ss, ["الأجهزة", "Devices"]);
    const paySheet = getSheetAuto(ss, ["مدفوعات الفنيين", "TechPayments"]);

    // تقرير الفترة + الرصيد الحقيقي التراكمي للفني.
    // الرصيد الحقيقي لا يعتمد على حالة الجهاز أو الشهر المختار:
    // كل مبلغ موجود في عمود "حقوق الفني" يدخل في المستحقات، ما عدا الوصل الملغى.
    let periodEarned = 0;
    let periodPaid = 0;
    let balanceEarned = 0;
    let balancePaid = 0;
    let repairedDevicesList = [];
    let paymentsList = [];

    function parseDateValue(value) {
      if (value instanceof Date && !isNaN(value.getTime())) return value;
      const str = String(value || '').trim();
      if (!str) return null;
      const d = new Date(str.replace(/-/g, '/'));
      return isNaN(d.getTime()) ? null : d;
    }

    function matchesSelectedMonth(value) {
      if (!selectedMonthYear || selectedMonthYear === "ALL") return true;
      const d = parseDateValue(value);
      if (!d) return false;
      const key = d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, '0');
      return key === selectedMonthYear;
    }

    if (devSheet && devSheet.getLastRow() > 1) {
      const devValues = devSheet.getDataRange().getValues();
      for (let i = 1; i < devValues.length; i++) {
        const row = devValues[i];
        const assignedTech = String(row[8] || '').trim();
        const status = String(row[10] || '').trim();
        const techCost = parseNumber(row[11]);
        const receptionDate = row[1];
        const actionDate = row[15] || row[14] || row[1];

        if (!techNamesMatch_(assignedTech, techName)) continue;
        if (status === "ملغى الوصل" || status.includes("ملغى")) continue;

        // الرصيد الحقيقي: كل حقوق الفني المسجلة، بلا شرط على الحالة.
        balanceEarned += techCost;

        // تقرير الفترة: نعتمد تاريخ الإجراء/الخروج، مع الرجوع لتاريخ الاستقبال.
        if (matchesSelectedMonth(actionDate)) {
          periodEarned += techCost;
        }

        const isDone = status === "جاهز للتسليم في المحل" ||
                       status === "مؤرشف ومسلم" ||
                       status.includes("تم التصليح") ||
                       status.includes("جاهز في الورشة") ||
                       status.includes("جاهز بالورشة") ||
                       status === "مرسل للمحل";

        if (isDone) {
          repairedDevicesList.push({
            receipt: String(row[0] || ''),
            customerName: String(row[2] || ''),
            deviceType: String(row[4] || '') + ' ' + String(row[5] || ''),
            problem: String(row[7] || ''),
            techCost: techCost,
            status: status,
            exitDate: String(actionDate || '')
          });
        }
      }
    }

    if (paySheet && paySheet.getLastRow() > 1) {
      const payValues = paySheet.getDataRange().getValues();
      for (let i = 1; i < payValues.length; i++) {
        const row = payValues[i];
        const paidDate = row[0];
        const paidTech = String(row[1] || '').trim();
        const amount = parseNumber(row[2]);
        if (!techNamesMatch_(paidTech, techName)) continue;

        balancePaid += amount;
        if (matchesSelectedMonth(paidDate)) periodPaid += amount;

        paymentsList.push({
          date: String(paidDate || ''),
          amount: amount,
          note: String(row[3] || '')
        });
      }
    }

    return {
      success: true,
      // أرقام التقرير للفترة المختارة.
      totalEarned: periodEarned,
      totalPaid: periodPaid,
      periodBalance: periodEarned - periodPaid,
      // الرصيد الحقيقي التراكمي، وهو الرقم الذي يجب أن يظهر للفني دائمًا.
      balanceEarned: balanceEarned,
      balancePaid: balancePaid,
      netBalance: balanceEarned - balancePaid,
      repairedCount: repairedDevicesList.length,
      devices: repairedDevicesList,
      payments: paymentsList
    };
  } catch (error) {
    return { success: false, error: error.toString() };
  }
}

