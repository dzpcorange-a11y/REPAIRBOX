function _rbGamifyNormalizeConfig_(cfg){
  const d=_rbGamifyDefaultConfig_();
  cfg=cfg||{};
  const techEnabled={};
  if(cfg.techEnabled&&typeof cfg.techEnabled==='object'){Object.keys(cfg.techEnabled).forEach(function(k){const nk=normalizeTechName_(k);if(nk)techEnabled[nk]=cfg.techEnabled[k]!==false;});}
  const out={
    enabled:cfg.enabled!==false,
    techEnabled:techEnabled,
    basePoints:Math.max(0,Math.min(1000,Number(cfg.basePoints)||d.basePoints)),
    speedEnabled:cfg.speedEnabled!==false,
    speed:{
      d1:Math.max(0,Math.min(200,Number(cfg.speed&&cfg.speed.d1)||0)),
      d2:Math.max(0,Math.min(200,Number(cfg.speed&&cfg.speed.d2)||0)),
      d3:Math.max(0,Math.min(200,Number(cfg.speed&&cfg.speed.d3)||0)),
      d5:Math.max(0,Math.min(200,Number(cfg.speed&&cfg.speed.d5)||0))
    },
    delayEnabled:cfg.delayEnabled!==false,
    delayGraceDays:Math.max(0,Math.min(60,Number(cfg.delayGraceDays)||d.delayGraceDays)),
    delayPenaltyPerWeek:Math.max(0,Math.min(100,Number(cfg.delayPenaltyPerWeek)||d.delayPenaltyPerWeek)),
    delayMaxPenalty:Math.max(0,Math.min(500,Number(cfg.delayMaxPenalty)||d.delayMaxPenalty)),
    returnEnabled:cfg.returnEnabled!==false,
    returnPenalty:Math.max(0,Math.min(500,Number(cfg.returnPenalty)||d.returnPenalty)),
    bonus:{enabled:!(cfg.bonus&&cfg.bonus.enabled===false),bonusPoints:Math.max(1,Math.min(100000,Number(cfg.bonus&&cfg.bonus.bonusPoints)||d.bonus.bonusPoints)),bonusAmount:Math.max(0,Math.min(1000000,Number(cfg.bonus&&cfg.bonus.bonusAmount)||d.bonus.bonusAmount)),minBonus:Math.max(1,Math.min(100000,Number(cfg.bonus&&cfg.bonus.minBonus)||d.bonus.minBonus))},
    conversionEnabled:true,
    conversionPoints:Math.max(1,Math.min(100000,Number(cfg.conversionPoints)||d.conversionPoints)),
    conversionAmount:Math.max(0,Math.min(1000000,Number(cfg.conversionAmount)||d.conversionAmount)),
    minConversionPoints:Math.max(1,Math.min(100000,Number(cfg.minConversionPoints)||d.minConversionPoints)),
    weekly:{
      enabled:!(cfg.weekly&&cfg.weekly.enabled===false),
      targetDevices:Math.max(1,Math.min(500,Number(cfg.weekly&&cfg.weekly.targetDevices)||d.weekly.targetDevices)),
      targetReward:Math.max(0,Math.min(100000,Number(cfg.weekly&&cfg.weekly.targetReward)||d.weekly.targetReward)),
      rankingEnabled:!(cfg.weekly&&cfg.weekly.rankingEnabled===false),
      rankingRewards:[1,2,3].map(function(i){return Math.max(0,Math.min(100000,Number(cfg.weekly&&cfg.weekly.rankingRewards&&cfg.weekly.rankingRewards[i-1])||d.weekly.rankingRewards[i-1]));}),
      weekStartsOn:6
    },
    levels:[]
  };
  const incoming=Array.isArray(cfg.levels)?cfg.levels:[];
  for(let i=0;i<6;i++){
    const x=incoming[i]||d.levels[i];
    out.levels.push({
      name:String(x.name||d.levels[i].name).trim().slice(0,40),
      icon:String(x.icon||d.levels[i].icon).trim().slice(0,8),
      min:Math.max(i===0?0:1,Math.min(100000,Number(x.min)||0)),
      reward:String(x.reward||'مكافأة').trim().slice(0,120),
      rewardAmount:Math.max(0,Math.min(100000,Number(x.rewardAmount)||0))
    });
  }
  out.levels[0].min=0;
  for(let i=1;i<out.levels.length;i++) out.levels[i].min=Math.max(out.levels[i].min,out.levels[i-1].min+1);
  return out;
}

