      const ds=getSheetAuto(ss,['الأجهزة','Devices']); if(ds&&ds.getLastRow()>1){const r=ds.getDataRange().getValues();for(let i=1;i<r.length;i++){if(String(r[i][8]||'').trim()===oldTech)ds.getRange(i+1,9).setValue(newTech);}}
