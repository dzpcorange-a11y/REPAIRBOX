    const row=Number(data&&data.row), name=String(data&&data.name||'').trim(), pin=normalizePin_(data&&data.pin);
    const roleRaw=String(data&&data.role||'').trim(); const role=(roleRaw==='فني'||roleRaw.toUpperCase()==='TECH')?'فني':(roleRaw==='ADMIN'||roleRaw==='مدير'?'ADMIN':'استقبال');
    if(!row || row<2 || row>ws.getLastRow()) return {success:false,error:'سطر الحساب غير صحيح.'};
    if(!name) return {success:false,error:'اسم العامل مطلوب.'};
