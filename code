function updateWorker(data, actorRole) {
  try {
    if(String(actorRole||'').toUpperCase()!=='ADMIN') return {success:false,error:'غير مصرح: المدير فقط.'};
    const ss=getSpreadsheet(); let ws=ensureRepairBoxWorkersSeeded_();
