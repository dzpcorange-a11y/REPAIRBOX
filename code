}

function getDevicesByStage(stageType, filterTech) {
  try {
    const ss = getSpreadsheet();
    const sheet = getSheetAuto(ss, ["الأجهزة", "Devices"]);
    if (!sheet || sheet.getLastRow() <= 1) return { success: true, data: [], readyInStoreCount: 0 };
    
    const values = sheet.getDataRange().getValues();
    const results = [];
    let readyInStoreCount = 0;
    const now = new Date();

    for (let i = 1; i < values.length; i++) {
      const row = values[i];
      if (!row[0]) continue;

      const status = String(row[10] || '').trim();
      const location = String(row[9] || '').trim();
      
      if (status === "جاهز للتسليم في المحل" && location === "في المحل") {
        readyInStoreCount++;
      }
    }

    for (let i = values.length - 1; i >= 1; i--) {
      const row = values[i];
      if (!row[0]) continue;
      
      const status = String(row[10] || '').trim();
      const location = String(row[9] || '').trim();
      const assignedTech = String(row[8] || '').trim();

      if (status === "مؤرشف ومسلم" || status.includes("تم التسليم") || location.includes("الأرشيف")) {
        continue;
      }

      // مطابقة مرنة لاسم الفني: تمنع اختفاء الجهاز بسبب (فني)، مسافات زائدة أو اختلاف بسيط في الاسم.
      if (filterTech && String(filterTech).trim().toUpperCase() !== "ALL" && !techNamesMatch_(assignedTech, filterTech)) {
        continue;
      }

      let isMatch = false;

      if (stageType === 'waiting' && status === "في الانتظار") {
        isMatch = true;
      } else if (stageType === 'workshop' && (status === "في انتظار قبول الفني" || status === "قيد التصليح في الورشة" || status.includes("جاهز في الورشة") || status.includes("جاهز بالورشة"))) {
        isMatch = true;
      } else if (stageType === 'tech_ready' && (status.includes("جاهز في الورشة") || status.includes("جاهز بالورشة") || status.includes("غير قابل للتصليح") || status === "مرسل للمحل")) {
        isMatch = true;
      } else if (stageType === 'ready' && status === "جاهز للتسليم في المحل") {
        isMatch = true;
      }

      if (isMatch) {
        // حساب عدد الأيام بالورشة
        let daysInWorkshop = 0;
        let entryDateStr = String(row[14] || '').trim();
        if (entryDateStr) {
          let entryDate = new Date(entryDateStr.replace(/-/g, "/"));
          if (!isNaN(entryDate.getTime())) {
            daysInWorkshop = Math.floor((now - entryDate) / (1000 * 60 * 60 * 24));
          }
        }

        // حساب عدد أيام الانتظار بالمحل كـ "جاهز"
        let daysReadyInStore = 0;
        let exitDateStr = String(row[15] || row[1] || '').trim();
        if (exitDateStr) {
          let exitDate = new Date(exitDateStr.replace(/-/g, "/"));
          if (!isNaN(exitDate.getTime())) {
            daysReadyInStore = Math.floor((now - exitDate) / (1000 * 60 * 60 * 24));
          }
        }

        results.push({
          rowId: i + 1,
          receipt: String(row[0] || ''),
          date: String(row[1] || ''),
          customerName: String(row[2] || ''),
          customerPhone: String(row[3] || ''),
          deviceType: String(row[4] || '') + ' ' + String(row[5] || '') + ' ' + String(row[6] || ''),
          problem: String(row[7] || ''),
          isRetour: String(row[7] || '').includes('RETOUR'),
          techName: assignedTech,
          location: location,
          status: status,
          techCost: parseNumber(row[11]),
          salePrice: parseNumber(row[12]),
          notes: String(row[13] || ''),
          repairDetails: String(row[16] || ''),
          // يبقى أثر نتيجة الصيانة محفوظاً حتى بعد تحويل الحالة إلى "جاهز للتسليم في المحل".
          // نقرأ سجل الحركات/ملاحظات الفني حتى تظهر رسالة "لم يصلح" في واجهة الجاهز للتسليم.
          wasNotRepaired: status.includes('غير قابل للتصليح') ||
                          String(row[13] || '').includes('غير قابل للتصليح') ||
                          String(row[16] || '').includes('غير قابل للتصليح'),
          entryWorkshopDate: entryDateStr,
          exitWorkshopDate: exitDateStr,
          daysInWorkshop: daysInWorkshop,
          daysReadyInStore: daysReadyInStore
        });
      }
    }
    // أجهزة RETOUR دائماً في الأعلى لأنها أولوية قصوى.
    results.sort(function(a, b) {
      return Number(b.isRetour) - Number(a.isRetour);
    });

    return { success: true, data: results, readyInStoreCount: readyInStoreCount };
  } catch (error) {
    return { success: false, error: error.toString() };
  }
}

