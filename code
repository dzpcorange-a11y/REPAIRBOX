function ensureRepairBoxWorkersSeeded_() {
  const ss=getSpreadsheet();
  let ws=getSheetAuto(ss,['الموظفين','Workers']);
  if(!ws){ ws=ss.insertSheet('الموظفين'); ws.appendRow(['اسم العامل','النوع','الكود الخاص (PIN)']); }
  const props=PropertiesService.getScriptProperties();
  if(props.getProperty('REPAIRBOX_WORKERS_SEEDED')==='1') return ws;
  const defaults=[
    ['المدير العام','ADMIN','808085'],
    ['سلامي','فني','17744'],['الهمكة','فني','860000'],['مداني','فني','16003'],['قزم','فني','101090'],['بوعلام','فني','202020']
  ];
  const vals=ws.getLastRow()>0?ws.getDataRange().getValues():[];
  const names={},pins={};
  for(let i=1;i<vals.length;i++){ const n=String(vals[i][0]||'').trim(); const p=String(vals[i][2]||'').replace(/^'/,'').trim(); if(n)names[n]=true; if(p)pins[p]=true; }
  defaults.forEach(function(d){ if(!names[d[0]] && !pins[d[2]]) ws.appendRow([d[0],d[1],"'"+d[2]]); });
  props.setProperty('REPAIRBOX_WORKERS_SEEDED','1');
  return ws;
}

