function saveDevice(data) {
  const lock = LockService.getScriptLock();
  try {
    // منع الضغط المكرر/الطلبات المتزامنة من إنشاء أكثر من جهاز.
    lock.waitLock(15000);
    setupDatabase();
    const ss = getSpreadsheet();
    const sheet = getSheetAuto(ss, ["الأجهزة", "Devices"]);
    
    const nextRow = getFirstEmptyRow(sheet);
    const receiptNum = "REC-" + (1000 + nextRow - 1);
    const nowStr = Utilities.formatDate(new Date(), ss.getSpreadsheetTimeZone(), "yyyy-MM-dd HH:mm:ss");
    
    const techMapping = {
      "لابتوب": "سلامي", "طابعة": "سلامي", "شاشة / تلفاز": "سلامي",
      "حاسوب مكتبي": "الهمكة", "هاتف": "الهمكة", "مودم / راوتر": "الهمكة",
      "كونسول / بلايستيشن": "مداني", "ذراع تحكم / مانيت": "مداني",
      "رسيفر / ديمو": "قزم", "تغذية / باور سبلاي": "قزم", "جهاز آخر": "بوعلام"
    };
    
    let assignedTech = data.assignedTech;
    if (!assignedTech || assignedTech === "auto") {
      assignedTech = techMapping[data.deviceType] || "بوعلام";
    }

    const logTrace = `⏱️ [${nowStr}] تم الإدخال بالاستقبال (الفني: ${assignedTech})`;

    const rowData = [
      receiptNum,
      nowStr,
      String(data.customerName || ''),
      "'" + String(data.customerPhone || ''),
      String(data.deviceType || ''),
      String(data.brand || 'عام'),
      String(data.model || 'عام'),
      String(data.problem || ''),
      assignedTech,
      "في المحل",
      "في الانتظار",
      0,
      0,
      logTrace + (data.notes ? (" | " + data.notes) : ""),
      "", 
      ""  
    ];

    sheet.getRange(nextRow, 1, 1, rowData.length).setValues([rowData]);

    return { 
      success: true, 
      receipt: receiptNum, 
      tech: assignedTech, 
      date: nowStr,
      customerName: data.customerName,
      customerPhone: data.customerPhone,
      deviceType: data.deviceType,
      brand: data.brand,
      model: data.model,
      problem: data.problem
    };
  } catch (error) {
    return { success: false, error: error.toString() };
  } finally {
    try { lock.releaseLock(); } catch (e) {}
  }
}


