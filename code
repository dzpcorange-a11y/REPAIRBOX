function getAdminFinancialSummary(selectedPeriod) {
  try {
    // V24.27 FIX: شاشة المدير المالية قراءة فقط؛ لا تستدعي setupDatabase عند التحميل.
    const ss = getSpreadsheet();
    const devSheet = getSheetAuto(ss, ["الأجهزة", "Devices"]);
    const paySheet = getSheetAuto(ss, ["مدفوعات الفنيين", "TechPayments"]);

    const now = new Date();
    const currentYear = now.getFullYear();
    const currentMonth = now.getMonth();
    const currentDay = now.getDate();

    const periodKey = String(selectedPeriod || "all").toLowerCase();
    const validPeriod = ["all", "today", "month", "year"].includes(periodKey) ? periodKey : "all";

    // قائمة الفنيين المالية يجب ألا تعتمد على ورقة الموظفين وحدها.
    // نبنيها من الحسابات + الأجهزة + المدفوعات حتى لا تتحول الأرقام إلى 0
    // إذا كان الفني موجوداً في سجل الأجهزة/المدفوعات ولم يكن موجوداً في ورقة الموظفين.
    const techNameSet = {};
    const techDisplayName = {};
    function addTechName_(name){
      const raw=String(name||'').trim();
      const key=normalizeTechName_(raw);
      if(!key) return;
      techNameSet[key]=true;
      const display=canonicalTechDisplayName_(raw);
      if(!techDisplayName[key] || display.length < techDisplayName[key].length) techDisplayName[key]=display;
    }

    let workerRes={success:false,workers:[]};
    try { workerRes=getWorkers(false)||workerRes; } catch(e) {}
    if(workerRes && workerRes.success){
      (workerRes.workers||[]).forEach(function(w){
        if(String(w.role||'').toUpperCase()==='TECH' || String(w.role||'').trim()==='فني') addTechName_(w.techName||w.name);
      });
    }

    // الأجهزة هي المصدر الفعلي لحقوق الفنيين.
    if(devSheet && devSheet.getLastRow()>1){
      const techVals=devSheet.getDataRange().getValues();
      for(let i=1;i<techVals.length;i++){
        if(String(techVals[i][10]||'').trim()==='ملغى الوصل') continue;
        addTechName_(techVals[i][8]);
      }
    }

    // والمدفوعات مصدر فعلي لأسماء الفنيين الذين تم التسديد لهم.
    if(paySheet && paySheet.getLastRow()>1){
      const payNames=paySheet.getDataRange().getValues();
      for(let i=1;i<payNames.length;i++) addTechName_(payNames[i][1]);
    }

    const uniqueTechNames = Object.keys(techNameSet);
    const allTechs = {};
    uniqueTechNames.forEach(function(key) { allTechs[key] = { earned:0, paid:0 }; });

    const period = {
      all:   { revenue: 0, tech: 0, paid: 0, cost: 0 },
      today: { revenue: 0, tech: 0, paid: 0, cost: 0 },
      month: { revenue: 0, tech: 0, paid: 0, cost: 0 },
      year:  { revenue: 0, tech: 0, paid: 0, cost: 0 }
    };

    let readyInStoreCount = 0;

    function parseDateValue(value) {
      if (value instanceof Date && !isNaN(value.getTime())) return value;
      const str = String(value || '').trim();
      if (!str) return null;

      const d = new Date(str.replace(/-/g, "/"));
      return isNaN(d.getTime()) ? null : d;
    }

    function matchesPeriod(dateValue, p) {
      const d = parseDateValue(dateValue);
      if (!d) return false;

      if (p === "all") return true;

      if (p === "today") {
        return d.getFullYear() === currentYear &&
               d.getMonth() === currentMonth &&
               d.getDate() === currentDay;
      }

      if (p === "month") {
        return d.getFullYear() === currentYear &&
               d.getMonth() === currentMonth;
      }

      if (p === "year") {
        return d.getFullYear() === currentYear;
      }

      return false;
    }

    if (devSheet && devSheet.getLastRow() > 1) {
      const values = devSheet.getDataRange().getValues();

      for (let i = 1; i < values.length; i++) {
        const row = values[i];

        const assignedTech = String(row[8] || '').trim();
        const location = String(row[9] || '').trim();
        const status = String(row[10] || '').trim();

        const techCost = parseNumber(row[11]);
        const salePrice = parseNumber(row[12]);

        // تاريخ إدخال/استقبال الجهاز = العمود B.
        // هذا هو تاريخ بداية استحقاق الفني.
        const receptionDate = row[1];

        // تاريخ التسليم الفعلي = العمود P.
        const deliveryDate = row[15];

        if (status === "جاهز للتسليم في المحل" && location === "في المحل") {
          readyInStoreCount++;
        }

        // الوصل الملغى لا يدخل في أي حساب.
        if (status === "ملغى الوصل") continue;

        // =====================================================
        // 1) حقوق الفنيين:
        // تدخل فور تسجيل مبلغ حقوق الفني، وليس عند التسليم.
        // جدول الفنيين يبقى كاملاً وتراكمياً.
        // =====================================================
        const earnedTechKey = normalizeTechName_(assignedTech);
        if (earnedTechKey && allTechs[earnedTechKey]) {
          allTechs[earnedTechKey].earned += techCost;
        }

        // بطاقات الفترة: حقوق الفني حسب تاريخ إدخال الجهاز.
        if (techCost !== 0) {
          period.all.tech += techCost;

          if (matchesPeriod(receptionDate, "today")) {
            period.today.tech += techCost;
          }

          if (matchesPeriod(receptionDate, "month")) {
            period.month.tech += techCost;
          }

          if (matchesPeriod(receptionDate, "year")) {
            period.year.tech += techCost;
          }
        }

        // =====================================================
        // 2) المداخيل والربح:
        // فقط عند التسليم الفعلي.
        // =====================================================
        if (status === "مؤرشف ومسلم") {
          const financialDate = parseDateValue(deliveryDate) || parseDateValue(receptionDate);

          period.all.revenue += salePrice;
          period.all.cost += techCost;

          if (matchesPeriod(financialDate, "today")) {
            period.today.revenue += salePrice;
            period.today.cost += techCost;
          }

          if (matchesPeriod(financialDate, "month")) {
            period.month.revenue += salePrice;
            period.month.cost += techCost;
          }

          if (matchesPeriod(financialDate, "year")) {
            period.year.revenue += salePrice;
            period.year.cost += techCost;
          }
        }
      }
    }

    // =========================================================
    // 3) المدفوعات:
    // جدول الفنيين = كامل وتراكمي.
    // بطاقة "المدفوع للفنيين" = حسب تاريخ الدفع.
    // =========================================================
    if (paySheet && paySheet.getLastRow() > 1) {
      const payValues = paySheet.getDataRange().getValues();

      for (let i = 1; i < payValues.length; i++) {
        const row = payValues[i];

        const paidDate = row[0];
        const paidTech = String(row[1] || '').trim();
        const amount = parseNumber(row[2]);

        const paidTechKey = normalizeTechName_(paidTech);
        if (!paidTechKey || !allTechs[paidTechKey]) continue;

        allTechs[paidTechKey].paid += amount;

        period.all.paid += amount;

        if (matchesPeriod(paidDate, "today")) {
          period.today.paid += amount;
        }

        if (matchesPeriod(paidDate, "month")) {
          period.month.paid += amount;
        }

        if (matchesPeriod(paidDate, "year")) {
          period.year.paid += amount;
        }
      }
    }

    // =========================================================
    // جدول الفنيين: دائماً الحساب الكامل ولا يتغير مع الفترة.
    // =========================================================
    // V24.0: دمج دفاعي نهائي قبل الإرسال للواجهة، حتى لا يظهر نفس الفني مرتين
    // مهما كانت صيغة الاسم أو محارف Unicode المخفية في المصدر.
    const mergedTechs = {};
    uniqueTechNames.forEach(function(key) {
      const canonicalKey = normalizeTechName_(key);
      if(!canonicalKey) return;
      if(!mergedTechs[canonicalKey]) {
        mergedTechs[canonicalKey] = {
          name: canonicalTechDisplayName_(techDisplayName[key] || key),
          earned: 0, paid: 0
        };
      }
      mergedTechs[canonicalKey].earned += Number(allTechs[key].earned || 0);
      mergedTechs[canonicalKey].paid += Number(allTechs[key].paid || 0);
      const candidate = canonicalTechDisplayName_(techDisplayName[key] || key);
      if(candidate && candidate.length < mergedTechs[canonicalKey].name.length) mergedTechs[canonicalKey].name = candidate;
    });
    const techsList = Object.keys(mergedTechs).map(function(key) {
      const item = mergedTechs[key];
      const remaining = Math.max(0, item.earned - item.paid);
      const overpaid = Math.max(0, item.paid - item.earned);
      return { name:item.name, earned:item.earned, paid:item.paid, remaining:remaining, overpaid:overpaid };
    });

    const totalTechLiability = techsList.reduce(function(sum, t) {
      return sum + t.earned;
    }, 0);

    const totalPaidToTechs = techsList.reduce(function(sum, t) {
      return sum + t.paid;
    }, 0);

    const periodResult = {};
    ["all", "today", "month", "year"].forEach(function(p) {
      periodResult[p] = {
        revenue: period[p].revenue,
        tech: period[p].tech,
        paid: period[p].paid,
        netProfit: period[p].revenue - period[p].cost
      };
    });

    // الأرقام التي تظهر في البطاقات تتغير حسب الفترة المختارة.
    const selected = periodResult[validPeriod];

    const labels = {
      all: "جميع الحسابات",
      today: "اليوم",
      month: "هذا الشهر",
      year: "هذه السنة"
    };

    return {
      success: true,

      selectedPeriod: validPeriod,
      periodLabel: labels[validPeriod],

      // أرقام البطاقات: تتغير مع الفترة.
      totalRevenue: selected.revenue,
      totalTechLiability: selected.tech,
      totalPaidToTechs: selected.paid,
      netStoreProfit: selected.netProfit,

      // الأرقام الكاملة: لاستخدامات أخرى وجدول الفنيين.
      allTotalRevenue: period.all.revenue,
      allTechLiability: totalTechLiability,
      allTotalPaidToTechs: totalPaidToTechs,
      allNetStoreProfit: period.all.revenue - period.all.cost,

      // توافق قديم.
      monthlyRevenue: period.month.revenue,
      monthlyNetProfit: period.month.revenue - period.month.cost,

      periods: periodResult,

      readyInStoreCount: readyInStoreCount,

      // مهم: الجدول يبقى كاملاً وتراكمياً مهما تغيرت الفترة.
      techsList: techsList,
      allTechsList: techsList
    };

  } catch (error) {
    return { success: false, error: error.toString() };
  }
}

