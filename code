function getWorkshopStatistics(period) {
  try {
    const ss = getSpreadsheet();
    const sheet = getSheetAuto(ss, ["الأجهزة", "Devices"]);
    const paySheet = getSheetAuto(ss, ["مدفوعات الفنيين", "TechPayments"]);
    if (!sheet) return {success:false, error:"ورقة الأجهزة غير موجودة."};

    const now = new Date();
    const p = String(period || 'month');
    const start = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    if (p === 'week') start.setDate(start.getDate() - 6);
    else if (p === 'month') start.setDate(1);
    else if (p === 'year') { start.setMonth(0,1); }
    else if (p === 'all') start.setTime(0);

    function inPeriod(v) {
      if (p === 'all') return true;
      let d = v instanceof Date ? v : new Date(v);
      return !isNaN(d.getTime()) && d >= start && d <= now;
    }
    function num(v){ const n=Number(String(v ?? '').replace(/[^0-9.-]/g,'')); return isNaN(n)?0:n; }

    const techMap = {};
    const rows = sheet.getDataRange().getValues();
    let completed=0, revenue=0, techRights=0;
    for(let i=1;i<rows.length;i++){
      const r=rows[i];
      const status=String(r[10]||'').trim();
      const tech=canonicalTechDisplayName_(String(r[8]||'').trim()) || 'غير محدد';
      const techKey=normalizeTechName_(tech) || 'غير محدد';
      const techCost=num(r[11]), sale=num(r[12]);
      const date = r[15] || r[14] || r[1];
      if(!inPeriod(date) || status.includes('ملغى')) continue;
      const done = status === 'مؤرشف ومسلم' || status.includes('تم الإصلاح') || status.includes('جاهز في الورشة') || status.includes('جاهز بالورشة') || status === 'مرسل للمحل' || status === 'جاهز للتسليم في المحل';
      if(!done) continue;
      completed++;
      techRights += techCost;
      if(status === 'مؤرشف ومسلم') revenue += sale;
      if(!techMap[techKey]) techMap[techKey]={name:tech,devices:0,earned:0,paid:0,remaining:0};
      techMap[techKey].devices++;
      techMap[techKey].earned += techCost;
    }

    if(paySheet && paySheet.getLastRow()>1){
      const pv=paySheet.getDataRange().getValues();
      for(let i=1;i<pv.length;i++){
        const r=pv[i], tech=canonicalTechDisplayName_(String(r[1]||'').trim()), techKey=normalizeTechName_(tech), amount=num(r[2]);
        if(!techKey) continue;
        if(!techMap[techKey]) techMap[techKey]={name:tech,devices:0,earned:0,paid:0,remaining:0};
        if(inPeriod(r[0])) techMap[techKey].paid += amount;
      }
    }
    Object.keys(techMap).forEach(k=>{
      techMap[k].remaining=Math.max(0,techMap[k].earned-techMap[k].paid);
      techMap[k].overpaid=Math.max(0,techMap[k].paid-techMap[k].earned);
    });
    const technicians=Object.values(techMap).sort((a,b)=>b.earned-a.earned);
    return {success:true,period:p,completed:completed,revenue:revenue,techRights:techRights,net:revenue-techRights,technicians:technicians};
  } catch(e){ return {success:false,error:String(e && e.message ? e.message : e)}; }
}

