// V22.15: آخر حركة جهاز — مصدر واحد للمدير والاستقبال، مع معالجة فشل الاتصال حتى لا تبقى الواجهة على "جاري التحميل".
function getLatestDeviceActivity(filterTech, userRole) {
  try {
    const ss = getSpreadsheet();
    const sheet = getSheetAuto(ss, ["الأجهزة", "Devices"]);
    if (!sheet || sheet.getLastRow() <= 1) return {success:true, latest:null};
    const values = sheet.getDataRange().getValues();
    let best = null;
    let bestTime = 0;
    const role = String(userRole || '').trim().toUpperCase();
    const filter = String(filterTech || '').trim();

    for (let i = 1; i < values.length; i++) {
      const row = values[i];
      if (!row[0]) continue;
      const tech = String(row[8] || '').trim();
      if (role === 'TECH' && filter && filter.toUpperCase() !== 'ALL' && !techNamesMatch_(tech, filter)) continue;
      const notes = String(row[13] || '').trim();
      const fallback = row[1] instanceof Date ? row[1].getTime() : new Date(String(row[1] || '').replace(/-/g,'/')).getTime();
      const matches = notes.match(/\[(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2})\]/g);
      let ts = 0, message = notes;
      if (matches && matches.length) {
        const lastStamp = matches[matches.length - 1].replace(/^\[|\]$/g,'');
        ts = new Date(lastStamp.replace(/-/g,'/')).getTime();
        const pos = notes.lastIndexOf(matches[matches.length - 1]);
        message = notes.slice(pos + matches[matches.length - 1].length).replace(/^\s*[|\n]+\s*/, '').trim() || notes;
      }
      if (!ts || isNaN(ts)) ts = fallback || 0;
      if (ts >= bestTime) {
        bestTime = ts;
        best = {
          receipt:String(row[0]||''),
          message:message.slice(-180),
          status:String(row[10]||''),
          timestamp: ts ? Utilities.formatDate(new Date(ts), ss.getSpreadsheetTimeZone(), 'yyyy-MM-dd HH:mm:ss') : String(row[1]||'')
        };
      }
    }
    return {success:true, latest:best};
  } catch (e) { return {success:false,error:e.toString()}; }
}

// V24.2: شريط المدير — آخر جهاز مُسلَّم وآخر جهاز أصبح جاهزاً عند الفني.
function getManagerTopActivities() {
  try {
    const ss = getSpreadsheet();
    const sheet = getSheetAuto(ss, ["الأجهزة", "Devices"]);
    if (!sheet || sheet.getLastRow() <= 1) return {success:true,lastDelivered:null,lastTechReady:null};
    const values = sheet.getDataRange().getValues();
    let lastDelivered = null, lastTechReady = null;
    let deliveredTs = 0, techReadyTs = 0;
    const parseDate = function(v){
      if(v instanceof Date && !isNaN(v.getTime())) return v.getTime();
      const s=String(v||'').trim();
      if(!s) return 0;
      const d=new Date(s.replace(/-/g,'/'));
      return isNaN(d.getTime()) ? 0 : d.getTime();
    };
    const lastNoteEvent = function(notes, patterns){
      const arr=String(notes||'').match(/\[(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2})\]/g)||[];
      for(let j=arr.length-1;j>=0;j--){
        const stamp=arr[j].replace(/^\[|\]$/g,'');
        const pos=String(notes||'').lastIndexOf(arr[j]);
        const after=String(notes||'').slice(pos+arr[j].length);
        if(patterns.some(function(p){return after.indexOf(p)>=0;})) return parseDate(stamp);
      }
      return 0;
    };
    for(let i=1;i<values.length;i++){
      const row=values[i];
      if(!row[0]) continue;
      const notes=String(row[13]||'');
      // التسليم النهائي محفوظ في العمود P، مع احتياط لسجل الحركة.
      let dTs=parseDate(row[15]);
      if(!dTs) dTs=lastNoteEvent(notes,['تم التسليم النهائي للزبون','إغلاق الوصل']);
      if(dTs && dTs>=deliveredTs){
        deliveredTs=dTs;
        lastDelivered={receipt:String(row[0]||''),customerName:String(row[2]||''),timestamp:Utilities.formatDate(new Date(dTs),ss.getSpreadsheetTimeZone(),'yyyy-MM-dd HH:mm:ss')};
      }
      // جاهز عند الفني: حالة إنهاء التصليح في الورشة قبل إرساله للمحل.
      let rTs=lastNoteEvent(notes,['تم إنهاء التصليح في الورشة']);
      if(!rTs && (String(row[10]||'').includes('جاهز في الورشة') || String(row[10]||'').includes('جاهز بالورشة'))) rTs=parseDate(row[15]) || parseDate(row[14]) || parseDate(row[1]);
      if(rTs && rTs>=techReadyTs){
        techReadyTs=rTs;
