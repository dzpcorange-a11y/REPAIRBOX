    const updatedProblem = `⚠️ [RETOUR - جهاز مُرجع] ${baseProblem} | عطل الإرجاع: ${notes}`;
    const updatedLog = currentLogs + `\n⏱️ [${nowStr}] ⚠️ تم إرجاع الجهاز إلى الورشة (RETOUR). السبب: ${notes}`;

    sheet.getRange(rowIndex, 8).setValue(updatedProblem);
    sheet.getRange(rowIndex, 10).setValue("في المحل");
    sheet.getRange(rowIndex, 11).setValue("في الانتظار");
    sheet.getRange(rowIndex, 14).setValue(updatedLog);
    SpreadsheetApp.flush();

    return { success:true, message:"⚠️ تم إرجاع الجهاز إلى الورشة والاستقبال بنجاح." };
  } catch (error) {
    return { success:false, error:String(error && error.message ? error.message : error) };
  }
}function getFilteredFinancialStats(period) {
  try {
    const ss = getSpreadsheet();
    const sheet = getSheetAuto(ss, ["الأجهزة", "Devices"]);
    const data = sheet.getDataRange().getValues();
    const now = new Date();

    let totalRevenue = 0;   // إجمالي المداخيل
    let totalTechCosts = 0; // إجمالي حقوق الفنيين
    let paidTechCosts = 0;  // المدفوع للفنيين

    for (let i = 1; i < data.length; i++) {
      const row = data[i];
      const deliveryStatus = String(row[9] || '');
      const itemDate = new Date(row[1]); // تاريخ تسجيل/تسليم الجهاز
      
      let isMatch = false;
      if (period === 'today') {
        isMatch = itemDate.toDateString() === now.toDateString();
      } else if (period === 'month') {
        isMatch = (itemDate.getMonth() === now.getMonth() && itemDate.getFullYear() === now.getFullYear());
      } else if (period === 'year') {
        isMatch = (itemDate.getFullYear() === now.getFullYear());
      } else {
        isMatch = true; // الكل
      }

      if (isMatch && (deliveryStatus.includes("تم التسليم") || deliveryStatus.includes("مكتمل"))) {
        totalRevenue += parseNumber(row[12]);   // سعر الجهاز الإجمالي
        totalTechCosts += parseNumber(row[11]); // حقوق الفني
      }
    }

    // حساب صافي أرباح المحل (المداخيل - حقوق الفنيين)
    const netProfit = totalRevenue - totalTechCosts;

    return {
      success: true,
      totalRevenue: totalRevenue,
      totalTechCosts: totalTechCosts,
      paidTechCosts: paidTechCosts,
      netProfit: netProfit
    };

  } catch (err) {
    return { success: false, error: err.toString() };
  }
}



