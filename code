function getTechPersonalReportsAdvanced(techName, filter) {
  try {
    const f = filter || {type:'month', month:Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM')};
    const type = String(f.type || 'month');
    const tz = Session.getScriptTimeZone() || 'Africa/Algiers';
    const today = new Date();
    const fmt = (d, pattern) => Utilities.formatDate(d, tz, pattern);
    let start=null, end=null, periodLabel='';
    function dateOnly(s){
      const str=String(s||'').trim(); if(!str) return null;
      const parts=str.split('-').map(Number); if(parts.length!==3 || parts.some(isNaN)) return null;
      return new Date(parts[0], parts[1]-1, parts[2], 0,0,0,0);
    }
    if(type==='day'){
      const d=dateOnly(f.day)||new Date(today.getFullYear(),today.getMonth(),today.getDate());
      start=new Date(d.getFullYear(),d.getMonth(),d.getDate()); end=new Date(start); end.setDate(end.getDate()+1); periodLabel='يوم '+fmt(start,'yyyy-MM-dd');
    } else if(type==='year'){
      const y=Number(f.year)||today.getFullYear(); start=new Date(y,0,1); end=new Date(y+1,0,1); periodLabel='سنة '+y;
    } else if(type==='monthSpecific'){
      const m=String(f.month||fmt(today,'yyyy-MM')); const a=m.split('-').map(Number); const y=a[0]||today.getFullYear(); const mo=(a[1]||today.getMonth()+1)-1; start=new Date(y,mo,1); end=new Date(y,mo+1,1); periodLabel='شهر '+fmt(start,'yyyy-MM');
    } else if(type==='custom'){
      start=dateOnly(f.start); end=dateOnly(f.end); if(!start||!end) return {success:false,error:'يجب تحديد تاريخ البداية والنهاية.'}; end.setDate(end.getDate()+1); if(end<=start) return {success:false,error:'تاريخ النهاية يجب أن يكون بعد تاريخ البداية.'}; periodLabel=fmt(start,'yyyy-MM-dd')+' إلى '+fmt(new Date(end.getTime()-86400000),'yyyy-MM-dd');
    } else {
      const m=String(f.month||fmt(today,'yyyy-MM')); const a=m.split('-').map(Number); const y=a[0]||today.getFullYear(); const mo=(a[1]||today.getMonth()+1)-1; start=new Date(y,mo,1); end=new Date(y,mo+1,1); periodLabel='شهر '+fmt(start,'yyyy-MM');
    }
    const base=getTechPersonalReports(techName,'ALL');
    if(!base || !base.success) return base || {success:false,error:'تعذر حساب التقرير.'};
    const ss=getSpreadsheet(), devSheet=getSheetAuto(ss,['الأجهزة','Devices']), paySheet=getSheetAuto(ss,['مدفوعات الفنيين','TechPayments']);
    function parseDate(v){ if(v instanceof Date&&!isNaN(v.getTime())) return v; const s=String(v||'').trim(); if(!s)return null; const d=new Date(s.replace(/-/g,'/')); return isNaN(d.getTime())?null:d; }
    function inRange(v){ const d=parseDate(v); return !!d && d>=start && d<end; }
    let devices=[], earned=0, paid=0;
    if(devSheet&&devSheet.getLastRow()>1){
      const vals=devSheet.getDataRange().getValues();
      for(let i=1;i<vals.length;i++){
        const r=vals[i], tech=String(r[8]||'').trim(), status=String(r[10]||'').trim(), cost=parseNumber(r[11]);
        if(!techNamesMatch_(tech, techName) || status==='ملغى الوصل' || status.includes('ملغى')) continue;
        const actionDate=r[15]||r[14]||r[1]; if(!inRange(actionDate)) continue;
        earned+=cost;
        const done=status==='جاهز للتسليم في المحل'||status==='مؤرشف ومسلم'||status.includes('تم التصليح')||status.includes('جاهز في الورشة')||status.includes('جاهز بالورشة')||status==='مرسل للمحل';
        if(done) devices.push({receipt:String(r[0]||''),customerName:String(r[2]||''),deviceType:String(r[4]||'')+' '+String(r[5]||''),problem:String(r[7]||''),techCost:cost,status:status,exitDate:String(actionDate||'')});
      }
    }
    if(paySheet&&paySheet.getLastRow()>1){
      const vals=paySheet.getDataRange().getValues();
      for(let i=1;i<vals.length;i++){ const r=vals[i]; if(String(r[1]||'').trim()!==techName)continue; if(inRange(r[0])) paid+=parseNumber(r[2]); }
    }
    return {success:true,totalEarned:earned,totalPaid:paid,periodBalance:earned-paid,netBalance:base.netBalance,balanceEarned:base.balanceEarned,balancePaid:base.balancePaid,repairedCount:devices.length,devices:devices,payments:base.payments||[],periodLabel:periodLabel};
  } catch(e){ return {success:false,error:String(e&&e.message?e.message:e)}; }
}

