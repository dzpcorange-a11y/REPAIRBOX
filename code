function updateWaitingDevice(data) {
  try {
    const ss = getSpreadsheet();
    const sheet = getSheetAuto(ss, ["الأجهزة", "Devices"]);
    const rowIndex = Number(data.rowId);

    const currentStatus = String(sheet.getRange(rowIndex, 11).getValue() || '').trim();
    if (currentStatus !== "في الانتظار") {
      return { success: false, error: "يمكن تعديل الأجهزة التي في حالة انتظار فقط!" };
    }

    const nowStr = Utilities.formatDate(new Date(), ss.getSpreadsheetTimeZone(), "yyyy-MM-dd HH:mm:ss");

    sheet.getRange(rowIndex, 5).setValue(String(data.deviceType || ''));

    const oldProblem = String(sheet.getRange(rowIndex, 8).getValue() || '');
    let newProblem = String(data.problem || '');
    if (oldProblem.includes("RETOUR") && !newProblem.includes("RETOUR")) {
      newProblem = "⚠️ [RETOUR - جهاز مُرجع] " + newProblem;
    }
    sheet.getRange(rowIndex, 8).setValue(newProblem);
    sheet.getRange(rowIndex, 9).setValue(String(data.assignedTech || ''));

    let oldNotes = String(sheet.getRange(rowIndex, 14).getValue() || '');
    let log = `\n✏️ [${nowStr}] تم تعديل البيانات (الفني: ${data.assignedTech} | الجهاز: ${data.deviceType} | العطل: ${data.problem})`;
    sheet.getRange(rowIndex, 14).setValue(oldNotes + log);

    return { success: true };
  } catch (error) {
    return { success: false, error: error.toString() };
  }
}

