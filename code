function getConnectedUsersStatus() {
  try {
    const ss = getSpreadsheet();
    const sh = _getUserSessionSheet_(ss);
    const values = sh.getDataRange().getValues();
    const now = Date.now();
    const ONLINE_MS = 120000; // مهلة متسامحة مع الهواتف التي توقف مؤقتاً المؤقتات في الخلفية.
    const users = {};

    for (let i=1;i<values.length;i++) {
      const sid=String(values[i][0]||'').trim();
      const name=String(values[i][1]||'').trim();
      const role=String(values[i][2]||'').trim();
      const hb=String(values[i][3]||'').trim();
      const login=String(values[i][4]||'').trim();
      const last=String(values[i][5]||'').trim();
      const status=String(values[i][6]||'').trim().toUpperCase();
      const hbMsRaw = values[i][7];
      if(!sid||!name) continue;

      let lastMs=Number(hbMsRaw)||0;
      if(!lastMs && hb){ try { lastMs=new Date(hb.replace(' ','T')+'Z').getTime(); } catch(e) {} }
      const online=status!=='OFFLINE' && lastMs>0 && (now-lastMs)<=ONLINE_MS;
      const item={sessionId:sid,userName:name,userRole:role,timestamp:login,lastSeen:hb||last,status:online?'ONLINE':'OFFLINE'};
      const key=name+'\u0000'+role.toUpperCase();
      const existing=users[key];

      // المستخدم الواحد يظهر مرة واحدة فقط. إذا وجدت جلسة ONLINE نفضّلها،
      // وإذا كانت الجلسات كلها OFFLINE نحتفظ بالأحدث فقط.
      if(!existing || (online && existing.status!=='ONLINE') || (item.status===existing.status && lastMs > (existing._lastMs||0))) {
        item._lastMs=lastMs;
        users[key]=item;
      }
    }

    const data=Object.keys(users).map(k=>{const x=users[k];delete x._lastMs;return x;})
      .sort((a,b)=>String(b.lastSeen).localeCompare(String(a.lastSeen)));
    return {success:true,data:data,onlineCount:data.filter(x=>x.status==='ONLINE').length};
  } catch (error) { return {success:false,error:error.toString(),data:[]}; }
}

