// V24.71: تعديل أسعار الجهاز من طرف المدير فقط، مع حفظ سجل واضح للتعديل.
// يمكن تعديل حقوق الفني (سعر التصليح) والسعر النهائي للزبون دون تغيير تواريخ الجهاز.
function adminEditDevicePrices(data, actorRole) {
  try {
    const role = String(actorRole || '').trim().toUpperCase();
    if (role !== 'ADMIN') {
      return { success:false, error:'غير مصرح. تعديل أسعار الأجهزة متاح للمدير فقط.' };
    }

    const rowId = Number(data && data.rowId);
    if (!rowId || rowId < 2) {
      return { success:false, error:'رقم سطر الجهاز غير صحيح.' };
    }

    const ss = getSpreadsheet();
    const sheet = getSheetAuto(ss, ['الأجهزة','Devices']);
    if (!sheet || rowId > sheet.getLastRow()) {
      return { success:false, error:'الجهاز غير موجود.' };
    }

    const receipt = String(sheet.getRange(rowId, 1).getValue() || '').trim();
    if (!receipt) return { success:false, error:'لم يتم العثور على رقم الوصل.' };

    const oldTechCost = parseNumber(sheet.getRange(rowId, 12).getValue());
    const oldSalePrice = parseNumber(sheet.getRange(rowId, 13).getValue());

    const hasTechCost = data && data.techCost !== undefined && data.techCost !== '';
    const hasSalePrice = data && data.salePrice !== undefined && data.salePrice !== '';
    if (!hasTechCost && !hasSalePrice) {
      return { success:false, error:'أدخل سعراً واحداً على الأقل للتعديل.' };
    }

    const newTechCost = hasTechCost ? parseNumber(data.techCost) : oldTechCost;
    const newSalePrice = hasSalePrice ? parseNumber(data.salePrice) : oldSalePrice;

    if (newTechCost < 0 || newSalePrice < 0) {
      return { success:false, error:'لا يمكن إدخال مبلغ سالب.' };
    }

    const changed = [];
    if (newTechCost !== oldTechCost) changed.push('حقوق الفني: ' + oldTechCost + ' ← ' + newTechCost + ' دج');
    if (newSalePrice !== oldSalePrice) changed.push('سعر الزبون: ' + oldSalePrice + ' ← ' + newSalePrice + ' دج');

    if (!changed.length) {
      return { success:true, receipt:receipt, changed:false, message:'لا يوجد تغيير في الأسعار.' };
    }

    const nowStr = Utilities.formatDate(new Date(), ss.getSpreadsheetTimeZone(), 'yyyy-MM-dd HH:mm:ss');
    sheet.getRange(rowId, 12).setValue(newTechCost);
    sheet.getRange(rowId, 13).setValue(newSalePrice);

    let oldNotes = String(sheet.getRange(rowId, 14).getValue() || '');
    const actor = String(data && data.actorName || 'المدير').trim() || 'المدير';
    const reason = String(data && data.reason || '').trim();
    let log = '\n✏️ [' + nowStr + '] تعديل أسعار من المدير (' + actor + ') | ' + changed.join(' | ');
    if (reason) log += ' | السبب: ' + reason;
    sheet.getRange(rowId, 14).setValue(oldNotes + log);

    return {
      success:true,
      receipt:receipt,
      changed:true,
      oldTechCost:oldTechCost,
      newTechCost:newTechCost,
      oldSalePrice:oldSalePrice,
      newSalePrice:newSalePrice,
      message:'تم تعديل الأسعار وتوثيق العملية بنجاح.'
    };
  } catch (e) {
    return { success:false, error:String(e && e.message ? e.message : e) };
  }
}


