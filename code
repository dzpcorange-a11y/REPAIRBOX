    const oldTech=oldRole==='فني'||oldRole.toUpperCase()==='TECH'?oldName.replace(/\(\s*فني\s*\)/gi,'').replace(/فني/gi,'').trim():'';
    const newTech=role==='فني'?name.replace(/\(\s*فني\s*\)/gi,'').replace(/فني/gi,'').trim():'';
