    for (let i=1;i<values.length;i++) {
      if (String(values[i][0] || '') === sid) {
        sh.getRange(i+1,2,1,7).setValues([[String(userName||values[i][1]||''),String(userRole||values[i][2]||''),nowStr,String(values[i][4]||nowStr),nowStr,'ONLINE',now.getTime()]]);
        return {success:true,timestamp:nowStr};
      }
    }
    // إذا فقدت الجلسة من الورقة، أعد إنشاءها دون إنشاء سجل دخول تاريخي جديد.
    sh.appendRow([sid,String(userName||''),String(userRole||''),nowStr,nowStr,nowStr,'ONLINE',now.getTime()]);
    return {success:true,timestamp:nowStr,recreated:true};
  } catch (error) { return {success:false,error:error.toString()}; }
}

