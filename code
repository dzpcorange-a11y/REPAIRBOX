function getDailyFinancialSummary() {
  try {
    const ss = getSpreadsheet();
    const devSheet = getSheetAuto(ss, ["الأجهزة", "Devices"]);
    if (!devSheet) return { success:false, error:"ورقة الأجهزة غير موجودة" };

    const tz = ss.getSpreadsheetTimeZone() || Session.getScriptTimeZone() || "Africa/Algiers";
    const now = new Date();
    const todayKey = Utilities.formatDate(now, tz, "yyyy-MM-dd");
    const todayDMY = Utilities.formatDate(now, tz, "dd-MM-yyyy");
    const todaySlash = Utilities.formatDate(now, tz, "dd/MM/yyyy");

    function isSameDay(value) {
      if (value === null || value === undefined || value === '') return false;
      if (Object.prototype.toString.call(value) === '[object Date]' && !isNaN(value.getTime())) {
        return Utilities.formatDate(value, tz, "yyyy-MM-dd") === todayKey;
      }
      const s = String(value).trim();
      if (!s) return false;
      // يدعم صيغ 2026-08-29 / 29-08-2026 / 29/08/2026 مع وقت اختياري.
      if (s.indexOf(todayKey) !== -1 || s.indexOf(todayDMY) !== -1 || s.indexOf(todaySlash) !== -1) return true;
      const d = new Date(s.replace(/-/g, '/'));
      return !isNaN(d.getTime()) && Utilities.formatDate(d, tz, "yyyy-MM-dd") === todayKey;
    }

    const lastRow = devSheet.getLastRow();
    if (lastRow <= 1) {
      return {success:true, todayStr:todayDMY, dailyRevenue:0, totalTechRights:0, dailyProfit:0, deliveredCount:0, techRightsList:[], devices:[]};
    }

    // نقرأ حتى العمود P لأن P هو تاريخ التسليم الفعلي.
    const values = devSheet.getRange(2, 1, lastRow - 1, Math.max(17, devSheet.getLastColumn())).getValues();
    let dailyRevenue = 0;
    let totalTechRights = 0;
    const deliveredDevicesList = [];
    const techRightsMap = {};

    values.forEach(function(row) {
      const status = String(row[10] || '').trim();       // K: الحالة
      if (status !== 'مؤرشف ومسلم') return;

      const salePrice = parseNumber(row[12]);             // M: السعر النهائي
      const techCost = parseNumber(row[11]);              // L: حقوق الفني
      const trackingNotes = row[13];                      // N: سجل التتبع
      const extraDate = row[14];                          // O: تاريخ دخول الورشة
      const deliveryDate = row[15];                       // P: تاريخ الخروج/التسليم

      // الأولوية لتاريخ التسليم P، مع إبقاء التوافق مع السجلات القديمة في N/O.
      const deliveredToday = isSameDay(deliveryDate) || isSameDay(trackingNotes) || isSameDay(extraDate);
      if (!deliveredToday) return;

      dailyRevenue += salePrice;
      totalTechRights += techCost;

      const techName = String(row[8] || '').trim() || 'غير محدد';
      if (!techRightsMap[techName]) techRightsMap[techName] = 0;
      techRightsMap[techName] += techCost;

      deliveredDevicesList.push({
        receipt: String(row[0] || ''),
        customerName: String(row[2] || ''),
        deviceType: [String(row[4] || ''), String(row[5] || ''), String(row[6] || '')].filter(Boolean).join(' '),
        techName: techName,
        amount: salePrice,
        techCost: techCost,
        profit: salePrice - techCost,
        deliveryDate: deliveryDate instanceof Date ? Utilities.formatDate(deliveryDate, tz, 'yyyy-MM-dd HH:mm:ss') : String(deliveryDate || '')
      });
    });

    const techRightsList = Object.keys(techRightsMap)
      .map(function(name) { return {name:name, amount:techRightsMap[name]}; })
      .filter(function(x) { return x.amount !== 0; })
      .sort(function(a,b) { return b.amount - a.amount; });

    return {
      success: true,
      todayStr: todayDMY,
      dailyRevenue: dailyRevenue,
      totalTechRights: totalTechRights,
      dailyProfit: dailyRevenue - totalTechRights,
      deliveredCount: deliveredDevicesList.length,
      techRightsList: techRightsList,
      devices: deliveredDevicesList
    };
  } catch (e) {
    return {success:false, error:String(e && e.message ? e.message : e)};
  }
}
