function _rbGamifyLevel_(points, cfg){
  const c=_rbGamifyNormalizeConfig_(cfg||getGamificationConfig().data);
  const p=Math.max(0,Number(points)||0);
  let current=c.levels[0];
  for(let i=0;i<c.levels.length;i++){if(p>=c.levels[i].min) current=c.levels[i]; else break;}
  const idx=c.levels.indexOf(current);
  const next=idx<c.levels.length-1?c.levels[idx+1].min:0;
  const progress=next?Math.min(100,Math.max(0,((p-current.min)/(next-current.min))*100)):100;
  return {name:current.name,icon:current.icon,min:current.min,next:next,reward:current.reward,rewardAmount:current.rewardAmount,progress:Math.round(progress),remaining:next?Math.max(0,next-p):0};
}

function _rbGamifyCompletedStatus_(status){
  const s=String(status||'').trim();
  return s==='مؤرشف ومسلم' || s==='تم الإصلاح' || s==='مرسل للمحل' || s==='جاهز للتسليم في المحل' || s.includes('جاهز في الورشة') || s.includes('جاهز بالورشة') || s.includes('تم الإصلاح');
}
function _rbGamifyDate_(v){
  if(v instanceof Date && !isNaN(v.getTime())) return v;
  const s=String(v||'').trim(); if(!s) return null;
  const d=new Date(s.replace(/-/g,'/')); return isNaN(d.getTime())?null:d;
}
function _rbGamifyDevicePoints_(row,cfg){
  const c=_rbGamifyNormalizeConfig_(cfg);
  if(!c.enabled || !_rbGamifyTechEnabled_(String(row[8]||''),c)) return {points:0,base:0,speedBonus:0,delayPenalty:0,returnPenalty:0,days:null,disabled:true};
  const status=String(row[10]||'').trim();
  if(!_rbGamifyCompletedStatus_(status)||status.includes('ملغى')) return null;
  const problem=String(row[7]||''), notes=String(row[13]||'');
  const entry=_rbGamifyDate_(row[14]) || _rbGamifyDate_(row[1]);
  const exit=_rbGamifyDate_(row[15]) || (status==='مؤرشف ومسلم'?_rbGamifyDate_(row[1]):null);
  let days=null;
  if(entry&&exit&&exit.getTime()>=entry.getTime()) days=Math.max(0,Math.floor((exit-entry)/(1000*60*60*24)));
  let base=c.basePoints,speedBonus=0,delayPenalty=0,returnPenalty=0;
  if(c.speedEnabled&&days!==null){
    if(days<=1)speedBonus=c.speed.d1;
    else if(days<=2)speedBonus=c.speed.d2;
    else if(days<=3)speedBonus=c.speed.d3;
    else if(days<=5)speedBonus=c.speed.d5;
  }
  if(c.delayEnabled&&days!==null&&days>c.delayGraceDays){
    delayPenalty=Math.min(c.delayMaxPenalty,Math.max(0,Math.ceil((days-c.delayGraceDays)/7))*c.delayPenaltyPerWeek);
  }
  if(c.returnEnabled&&(problem.includes('RETOUR')||notes.includes('RETOUR')||notes.includes('تم إرجاع الجهاز'))) returnPenalty=c.returnPenalty;
  const total=Math.max(0,base+speedBonus-delayPenalty-returnPenalty);
  return {points:total,base:base,speedBonus:speedBonus,delayPenalty:delayPenalty,returnPenalty:returnPenalty,days:days};
}

